<Window x:Class="NetRecon.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NetRecon IP Scanner 1.5 alpha" Height="640" Width="980" MinHeight="560" MinWidth="860">
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Exit" Click="ExitMenu_Click"/>
            </MenuItem>
            <MenuItem Header="Options">
                <MenuItem Header="Show Start button" x:Name="OptShowStart" IsCheckable="True" IsChecked="True" Checked="ButtonVisibilityChanged" Unchecked="ButtonVisibilityChanged"/>
                <MenuItem Header="Show Stop button" x:Name="OptShowStop" IsCheckable="True" IsChecked="True" Checked="ButtonVisibilityChanged" Unchecked="ButtonVisibilityChanged"/>
                <MenuItem Header="Show Clear button" x:Name="OptShowClear" IsCheckable="True" IsChecked="True" Checked="ButtonVisibilityChanged" Unchecked="ButtonVisibilityChanged"/>
                <Separator/>
                <MenuItem Header="Show External IP button" x:Name="OptShowExternalIp" IsCheckable="True" IsChecked="True" Checked="ButtonVisibilityChanged" Unchecked="ButtonVisibilityChanged"/>
                <MenuItem Header="Show Local IP button" x:Name="OptShowLocalIp" IsCheckable="True" IsChecked="True" Checked="ButtonVisibilityChanged" Unchecked="ButtonVisibilityChanged"/>
                <MenuItem Header="Show Local Subnets button" x:Name="OptShowLocalSubnets" IsCheckable="True" IsChecked="True" Checked="ButtonVisibilityChanged" Unchecked="ButtonVisibilityChanged"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Scan time:"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="ScanTimeText" Text="0.0s" FontWeight="SemiBold"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="BtnStart" Content="Start" Width="90" Margin="0,0,6,0" Click="BtnStart_Click"/>
                <Button x:Name="BtnStop" Content="Stop" Width="90" Margin="0,0,6,0" IsEnabled="False" Click="BtnStop_Click"/>
                <Button x:Name="BtnClear" Content="Clear" Width="90" Margin="0,0,18,0" Click="BtnClear_Click"/>

                <Button x:Name="BtnExternalIp" Content="My External IP" Width="130" Margin="0,0,6,0" Click="BtnExternalIp_Click"/>
                <Button x:Name="BtnLocalIp" Content="My Local IP" Width="110" Margin="0,0,6,0" Click="BtnLocalIp_Click"/>
                <Button x:Name="BtnLocalSubnets" Content="Local Subnets" Width="120" Click="BtnLocalSubnets_Click"/>
            </StackPanel>

            <GroupBox Grid.Row="1" Header="Scan settings" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="IP Range" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" x:Name="IpRangeText" Text="192.168.1.1 - 192.168.1.254"/>

                    <TextBlock Grid.Column="3" Text="Ports" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="4" x:Name="PortsText" Text="80,443,8080"/>

                    <TextBlock Grid.Column="6" Text="Delay (ms)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="7" x:Name="DelayText" Text="0"/>

                    <TextBlock Grid.Column="9" Text="Threads" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="10" x:Name="ThreadsText" Text="20"/>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Checked:" FontWeight="Bold"/>
                <TextBlock x:Name="CheckedText" Text="0" Margin="4,0,12,0"/>
                <TextBlock Text="Found:" FontWeight="Bold"/>
                <TextBlock x:Name="FoundText" Text="0" Margin="4,0,12,0"/>
                <TextBlock Text="Open ports:" FontWeight="Bold"/>
                <TextBlock x:Name="OpenPortsText" Text="0" Margin="4,0,12,0"/>
            </StackPanel>

            <DataGrid Grid.Row="3" x:Name="ResultsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy IP" Click="CopyIp_Click"/>
                        <MenuItem Header="Copy Ports" Click="CopyPorts_Click"/>
                        <Separator/>
                        <MenuItem Header="Hostname" Click="ShowHostname_Click"/>
                        <MenuItem Header="Open in Browser" Click="OpenInBrowser_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IP Address" Binding="{Binding Ip}" Width="200"/>
                    <DataGridTextColumn Header="Ping" Binding="{Binding Ping}" Width="120"/>
                    <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" Width="220"/>
                    <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="200"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
