{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetRecon IP Scanner",
  "version": "1.4.0",
  "identifier": "com.netrecon.ipscanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prepare:app",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NetRecon IP Scanner",
        "width": 900,
        "height": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
