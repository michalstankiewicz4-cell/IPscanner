{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OSINT NET Auditor",
  "mainBinaryName": "OSINTNETAuditor",
  "version": "2.7.0",
  "identifier": "com.netrecon.ipscanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run prepare:app",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OSINT NET Auditor v2.7.0",
        "url": "index.html",
        "width": 900,
        "height": 620,
        "maximized": true,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob: http: https:; script-src 'self' 'unsafe-inline' blob: https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' http: https:; img-src 'self' data: blob: http: https:; connect-src 'self' ipc: http: https: ws: wss:; font-src 'self' data:; frame-src 'self' http: https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none';",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../scripts/*.ps1"
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer-template.nsi"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
